
##############################################
# SECRETS & ENVIRONMENT — never commit these
##############################################

# Ignores your main local environment file (API keys, DB URLs, etc.)
.env

# Ignores environment files for specific environments (.env.local, .env.production, etc.)
.env.*

# EXCEPTION: un-ignores a safe example file with placeholder values,
# so teammates know which variables they need to fill in themselves.
# The leading "!" means "don't ignore this one, even though it matches .env.* above"
!.env.example

# Ignores Firebase/GCP service account key files (grant full admin access if leaked)
serviceAccountKey.json

# Ignores any Firebase admin SDK key, whatever it's named
# (Firebase auto-names these like "yourproject-firebase-adminsdk-xxxxx.json")
*-firebase-adminsdk-*.json

# Ignores any generic GCP credentials file you might download from the console
gcp-key.json
credentials.json


##############################################
# DEPENDENCIES — reinstalled from package.json, never stored in git
##############################################

# Ignores installed npm/yarn packages (huge, and regenerated by `npm install`)
node_modules/

# Ignores the same thing, but inside your Cloud Functions folder specifically
# (functions/ usually has its own separate node_modules)
functions/node_modules/


##############################################
# BUILD OUTPUT — generated by build tools, not source code
##############################################

# Generic build output folder used by many frontend frameworks
dist/

# Generic build output folder used by Create React App, some Node setups, etc.
build/

# Next.js build output folder
.next/

# Vite build output folder
out/

# Compiled TypeScript info cache (speeds up rebuilds, but is machine-specific)
*.tsbuildinfo


##############################################
# FIREBASE — local tooling files, not part of your actual app code
##############################################

# Ignores the Firebase CLI's local cache/config folder
.firebase/

# Ignores debug logs the Firebase CLI writes when something goes wrong locally
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log


##############################################
# CLAUDE CODE — personal/local files that shouldn't be shared via git
##############################################

# Your personal project notes/preferences — meant for you only, per device
# (your shared instructions stay in the committed CLAUDE.md, not this one)
CLAUDE.local.md

# Your personal Claude Code settings for this project (e.g. your own permission
# overrides) — the shared team settings live in the committed .claude/settings.json
.claude/settings.local.json

# Temporary folders Claude Code creates when you use --worktree for feature
# branches or parallel sessions — these are disposable working copies, not source
.claude/worktrees/


##############################################
# LOGS — runtime output, regenerated every time you run the app
##############################################

# Catches any file ending in .log, anywhere in the project
*.log

# npm's own debug logs when an install fails
npm-debug.log*

# yarn's own debug logs when an install fails
yarn-error.log*


##############################################
# TESTING — generated by test runners, not something to commit
##############################################

# Code coverage reports generated after running tests
coverage/


##############################################
# OPERATING SYSTEM CLUTTER — files your OS creates automatically
##############################################

# macOS creates this invisible file in every folder you open in Finder
.DS_Store

# Windows creates this invisible file to cache folder thumbnail previews
Thumbs.db


##############################################
# EDITOR / IDE — personal editor settings, not project settings
##############################################

# JetBrains IDEs (WebStorm, IntelliJ) store personal project settings here
.idea/

# EXCEPTION: if your team DOES want to share specific VS Code settings
# (like recommended extensions), keep the folder but ignore personal parts only.
# Comment the next line OUT if you want to share .vscode/ settings with your team.
.vscode/
