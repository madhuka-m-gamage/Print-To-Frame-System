# Copy to .env.local and fill in. Never commit real values.
# Tests use .env.test (emulator only, fake demo- ids). See README.md.

# ── Client (exposed to the browser; VITE_ prefix required) ──────────────
# Firebase web app config. Fetch the current values with:
#   firebase apps:sdkconfig WEB <appId> --project <project-id>
# Today the app falls back to firebase-applet-config.json when these are unset.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
# Set to true only together with a demo- project id to talk to the local emulators.
VITE_USE_FIREBASE_EMULATOR=
# Google Maps key used for address search and routes (restrict it by domain).
VITE_GOOGLE_MAPS_API_KEY=
# Error reporting (Sentry DSN). Leave empty to disable.
VITE_SENTRY_DSN=

# ── Server (Vercel functions in api/ and the dev proxy; never exposed) ───
# Gemini key for /api/generate. VITE_GEMINI_API_KEY is accepted as a fallback.
GEMINI_API_KEY=
# Full service-account JSON on one line. Needed by /api/generate, /api/admin-user and /api/send-email.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Sending mailbox for /api/send-email and its Gmail app password (not the login password).
SMTP_USER=
SMTP_APP_PASSWORD=
