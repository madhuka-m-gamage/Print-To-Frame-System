# Emulator-only environment, loaded by `vite --mode test` (npm run dev:emulated).
# Contains only the fake demo project id and placeholder values. Never put a real key here.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-print2frame-test
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=demo-print2frame-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_OAUTH_CLIENT_ID=demo-oauth-client-id
