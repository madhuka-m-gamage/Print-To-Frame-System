rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user has a specific role
    function hasRole(role) {
      return isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == role;
    }
    
    // The caller's own users document. Only call after checking exists().
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    // An approved, active account. A Deactivated or Disabled status always wins, even
    // when isApproved is still true; otherwise the account needs isApproved == true or
    // status == 'Active' (auth DP-03, rbac finding 1).
    function isActiveUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && !(callerDoc().get('status', '') in ['Deactivated', 'Disabled'])
        && (callerDoc().get('isApproved', false) == true || callerDoc().get('status', '') == 'Active');
    }

    // Check if the user is an Admin. The bootstrap owner emails count as Admin even
    // before their users document exists or if it is ever corrupted (auth DP-06).
    function isAdmin() {
      return ((hasRole('admin') || hasRole('Admin')) && isActiveUser())
        || (isAuthenticated() && isBootstrapSuperAdmin(request.auth.token.email));
    }

    function isAdminRole(role) {
      return role in ['Admin', 'admin'];
    }

    // The two hardcoded owner emails the client app itself treats as a bootstrap/
    // self-healing super-admin (see App.jsx "Self-Healing Super Admin Guard").
    // Mirrored here so the rules stay consistent with that one intentional exception
    // instead of trusting the client to enforce it.
    function isBootstrapSuperAdmin(email) {
      return email == 'madhukagamage6@gmail.com' || email == 'madhukagamage@gmail.com';
    }

    // Dynamic Permission Check (supports both new granular {view, create, edit, delete, export} and legacy {read, write})
    function checkPermission(module, action) {
      return isAdmin() || (
        isActiveUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && exists(/databases/$(database)/documents/settings/permissions)
        && (
             // Direct key match (e.g. view, create, edit, delete, export, read, write)
             get(/databases/$(database)/documents/settings/permissions).data
               .get(get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role, {})
               .get(module, {})
               .get(action, false) == true
             // If checking 'read', also accept 'view'
             || (action == 'read' && get(/databases/$(database)/documents/settings/permissions).data
                  .get(get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role, {})
                  .get(module, {})
                  .get('view', false) == true)
             // If checking 'write', also accept 'create' or 'edit'
             || (action == 'write' && (
                  get(/databases/$(database)/documents/settings/permissions).data
                    .get(get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role, {})
                    .get(module, {})
                    .get('create', false) == true
                  || get(/databases/$(database)/documents/settings/permissions).data
                    .get(get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role, {})
                    .get(module, {})
                    .get('edit', false) == true
                ))
        )
      );
    }

    // ── Settings (Dynamic Permissions) ────────────────────
    // This document IS the RBAC matrix that checkPermission() reads for every other
    // collection below — it must only ever be writable by an Admin. (Previously
    // `if isAuthenticated()` let ANY signed-in user of ANY role grant themselves
    // full access to everything by rewriting this document directly.)
    match /settings/permissions {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── User Profiles ─────────────────────────────────────
    // SECURITY: `role`, `isApproved`, and `status` must never be settable by the user
    // themselves except through the two narrow, intentional self-service paths the app
    // already relies on:
    //   1. A brand-new Google sign-in self-provisions its own profile as 'Customer',
    //      unapproved and pending (isApproved: false, status: 'Pending').
    //   2. The two hardcoded owner emails self-heal back to 'Admin'/Active if ever changed.
    // Anything else — including a non-admin flipping their own role to 'Admin', or
    // self-approving / self-reactivating after being deactivated, via the Firestore SDK
    // directly (bypassing the UI) — is rejected.
    // Read: Admin, the user themselves, or a role that manages users or uses messaging
    // (rbac finding 12). A Manager holding the agents permission may also administer
    // users (employees D4), but never grant Admin, touch an Admin, or change their own
    // role, approval or status.
    match /users/{userId} {
      allow read: if isAdmin()
        || (isAuthenticated() && request.auth.token.email == userId)
        || checkPermission('agents', 'view')
        || checkPermission('messages', 'view');

      allow create: if isAdmin()
        || (checkPermission('agents', 'create') && !isAdminRole(request.resource.data.get('role', '')))
        || (isAuthenticated() && request.auth.token.email == userId && (
             (request.resource.data.role == 'Customer'
               && request.resource.data.isApproved == false
               && request.resource.data.status == 'Pending')
             || (isBootstrapSuperAdmin(userId) && request.resource.data.role == 'Admin')
           ));

      allow update: if isAdmin()
        || (checkPermission('agents', 'edit')
             && request.auth.token.email != userId
             && !isAdminRole(resource.data.get('role', ''))
             && !isAdminRole(request.resource.data.get('role', '')))
        || (isAuthenticated() && request.auth.token.email == userId && (
             (request.resource.data.role == resource.data.role
               && request.resource.data.isApproved == resource.data.isApproved
               && request.resource.data.status == resource.data.status)
             || (isBootstrapSuperAdmin(userId) && request.resource.data.role == 'Admin')
           ));

      allow delete: if isAdmin()
        || (checkPermission('agents', 'delete')
             && request.auth.token.email != userId
             && !isAdminRole(resource.data.get('role', '')));
    }

    // ── Pending Users ─────────────────────────────────────
    match /pendingUsers/{userId} {
      allow create: if true;
      allow read: if isAuthenticated() && request.auth.token.email == userId;
      // An applicant may finish their own registration record (auth DP-02), but never
      // mark it approved; approval is an Admin action.
      allow update: if isAuthenticated() && request.auth.token.email == userId
        && request.resource.data.get('isApproved', false) == false;
      allow read, update, delete: if isAdmin() || checkPermission('agents', 'edit');
    }

    // ── Partner Applications (public "Register Partner" request form) ────
    // Submitted anonymously by prospective partners, then reviewed and
    // approved/rejected only from User Management (see AgentDatabase.jsx) —
    // same review-queue shape as pendingUsers above.
    match /partner_applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || checkPermission('agents', 'edit');
    }

    // ── Leads (CRM) ──────────────────────────────────────
    // Deals are stored here with isDeal == true, so they are governed by the pipeline
    // permission and plain leads by the leads permission; either one may read.
    match /leads/{leadId} {
      allow read: if checkPermission('leads', 'view') || checkPermission('leads', 'read')
        || checkPermission('pipeline', 'view') || checkPermission('pipeline', 'read');
      allow create: if (request.resource.data.get('isDeal', false) == true
            ? (checkPermission('pipeline', 'create') || checkPermission('pipeline', 'write'))
            : (checkPermission('leads', 'create') || checkPermission('leads', 'write')))
        || (request.resource.data.get('source', '') == 'Referral');
      allow update: if (resource.data.get('isDeal', false) == true
            ? (checkPermission('pipeline', 'edit') || checkPermission('pipeline', 'write'))
            : (checkPermission('leads', 'edit') || checkPermission('leads', 'write')));
      allow delete: if checkPermission('leads', 'delete');
    }

    // ── Deals ────────────────────────────────────────────
    // Unused: the app stores deals in `leads` with isDeal == true (see above). Kept only
    // so a stray write to a `deals` collection is not silently denied by the catch-all.
    match /deals/{dealId} {
      allow read: if checkPermission('pipeline', 'view') || checkPermission('pipeline', 'read');
      allow create, update: if checkPermission('pipeline', 'create') || checkPermission('pipeline', 'edit') || checkPermission('pipeline', 'write');
      allow delete: if isAdmin();
    }

    // ── Quotations ────────────────────────────────────────
    match /quotations/{quotationId} {
      allow read: if checkPermission('quotations', 'view') || checkPermission('quotations', 'read');
      allow create: if checkPermission('quotations', 'create') || checkPermission('quotations', 'write');
      allow update: if checkPermission('quotations', 'edit') || checkPermission('quotations', 'write');
      allow delete: if checkPermission('quotations', 'delete');
    }

    // ── Sequential-ID counters (e.g. invoice numbering) ──────
    // Holds only a single incrementing integer per prefix — no business
    // data — written via a Firestore transaction from generateInvoiceId().
    // Only the known prefixes, holding a single positive integer { value } that can
    // step ahead by at most one, so a caller cannot invent a counter or jump a
    // sequence forward. There is deliberately no lower bound against the stored value:
    // client transactions are checked at commit against the latest document, so under
    // contention a queued writer holds a value that is already behind it and a strict
    // "must increase" rule rejects legitimate calls. A signed-in user can therefore
    // still lower a counter; closing that needs the numbering moved server-side.
    function isKnownCounter(counterId) {
      return counterId in ['INV-ADV', 'INV-FIN', 'L-DL', 'L-PK', 'PTF', 'QT', 'L', 'D'];
    }
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isKnownCounter(counterId)
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value == 1;
      allow update: if isAuthenticated() && isKnownCounter(counterId)
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= resource.data.value + 1;
    }

    // ── Invoices ─────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if checkPermission('invoices', 'view') || checkPermission('invoices', 'read') || (isAuthenticated() && resource.data.customerId == request.auth.token.email) || (isAuthenticated() && resource.data.partnerId == request.auth.token.email);
      allow create, update: if checkPermission('invoices', 'create') || checkPermission('invoices', 'edit') || checkPermission('invoices', 'write');
      allow delete: if checkPermission('invoices', 'delete');
    }

    // ── Receipts (payment-received records issued against paid invoices) ──
    match /receipts/{receiptId} {
      allow read: if checkPermission('receipts', 'view') || checkPermission('receipts', 'read')
        || (isAuthenticated() && resource.data.customerId == request.auth.token.email)
        || (isAuthenticated() && resource.data.partnerId == request.auth.token.email);
      allow create, update: if checkPermission('receipts', 'create') || checkPermission('receipts', 'edit') || checkPermission('receipts', 'write');
      allow delete: if checkPermission('receipts', 'delete');
    }

    // ── Customers ────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if checkPermission('customers', 'view') || checkPermission('customers', 'read')
        || (isAuthenticated() && (resource.data.email == request.auth.token.email || resource.data.nic == request.auth.token.email));
      // A client may keep their own profile up to date (customers Decision 9), and only
      // the fields UserProfile.jsx syncs, never order or financial fields.
      allow update: if isAuthenticated()
        && (resource.data.email == request.auth.token.email || resource.data.nic == request.auth.token.email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'phone', 'address']);
      allow create, update: if checkPermission('customers', 'create') || checkPermission('customers', 'edit') || checkPermission('customers', 'write');
      allow delete: if checkPermission('customers', 'delete') || isAdmin();
    }

    // ── Partners & Commission Ledgers ────────────────────
    match /partners/{partnerId} {
      allow read: if checkPermission('partners', 'view') || checkPermission('partners', 'read') || (isAuthenticated() && partnerId == request.auth.token.email);
      allow create, update: if checkPermission('partners', 'create') || checkPermission('partners', 'edit') || checkPermission('partners', 'write');
      allow delete: if checkPermission('partners', 'delete') || isAdmin();
    }

    // ── Referral Claims (partners report referrals the system missed) ──────
    // Any signed-in user may file a claim; only staff reviewers and the claiming partner
    // read them, and only an Admin resolves or removes them (partners D-6).
    match /referral_claims/{claimId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin()
        || (checkPermission('partners', 'view') && !hasRole('Partner'))
        || (isAuthenticated() && resource.data.get('partnerEmail', '') == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // ── Partner Payouts (commission disbursement records) ──────────────────
    // Written only by an Admin. Partners see their own payouts; the Partner role's
    // partners permission does not open other partners' payouts (partners D-6).
    match /partner_payouts/{payoutId} {
      allow read: if isAdmin()
        || (checkPermission('partners', 'view') && !hasRole('Partner'))
        || (isAuthenticated() && (resource.data.get('partnerEmail', '') == request.auth.token.email
             || resource.data.get('partnerId', '') == request.auth.token.email));
      allow create, update, delete: if isAdmin();
    }

    // ── Fabrication / Projects ───────────────────────────
    match /projects/{projectId} {
      allow read: if checkPermission('projects', 'view') || checkPermission('projects', 'read') || (isAuthenticated() && resource.data.customerId == request.auth.token.email);
      allow create, update: if checkPermission('projects', 'create') || checkPermission('projects', 'edit') || checkPermission('projects', 'write');
      allow delete: if checkPermission('projects', 'delete');
    }

    // ── Logistics ────────────────────────────────────────
    match /logistics/{logId} {
      allow read: if checkPermission('logistics', 'view') || checkPermission('logistics', 'read') || (isAuthenticated() && resource.data.customerId == request.auth.token.email);
      allow create, update: if checkPermission('logistics', 'create') || checkPermission('logistics', 'edit') || checkPermission('logistics', 'write');
      allow delete: if checkPermission('logistics', 'delete');
    }

    // ── Pricing Config (Admin-only write) ────────────────
    match /pricing/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Messages (Real-Time Internal Chat) ─────────────────
    // `update` used to be open to any authenticated user for any message — that let
    // anyone silently rewrite someone else's message content after the fact. Now only
    // the original sender (or an Admin) can edit a message. A conversation participant
    // may still update a message that isn't theirs, but ONLY to touch `readBy` — this is
    // what markChatAsRead() needs to record read receipts on the other party's messages.
    // Read: only a conversation's participants (or an Admin) with the messages permission.
    // Create: only as yourself and only into a conversation you are part of (D-MSG-01/02).
    match /messages/{messageId} {
      allow read: if checkPermission('messages', 'view')
        && (isAdmin() || request.auth.token.email in resource.data.participants);
      allow create: if checkPermission('messages', 'create')
        && request.resource.data.fromId == request.auth.token.email
        && request.auth.token.email in request.resource.data.participants;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.fromId == request.auth.token.email)
        || (isAuthenticated() && request.auth.token.email in resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt']));
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.fromId == request.auth.token.email &&
        (request.time.toMillis() - resource.data.timestamp) < 900000
      );
    }

    // ── Typing Indicators ────────────────────────────────
    match /typing_indicators/{indicatorId} {
      allow read, write: if isAuthenticated();
    }

    // ── Audit Log ────────────────────────────────────────
    match /auditLog/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Test Connection ──────────────────────────────────
    match /test/{docId} {
      allow read: if true;
    }

    // ── Catch-all: deny everything else ──────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
